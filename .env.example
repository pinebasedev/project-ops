# Deploy-time configuration, read by Alchemy (`alchemy.run.ts`). Copy to `.env`
# (gitignored) to fill in, or let `scripts/deploy-wizard.sh` write it for you.
#
# LOCAL DEV (`pnpm dev` = `alchemy dev`) needs none of this. It does need a
# Cloudflare identity once: `pnpm alchemy profile edit --add Cloudflare`.
#
# There is no Cloudflare API token in this file. Alchemy authenticates with its
# own OAuth session, cached to `~/.alchemy` (ADR-0012).

# Required to deploy. Zero Trust: the team subdomain (<team>.cloudflareaccess.com),
# the UUID of the Google identity provider configured in the org, and the one
# email address allowed to log in to the dashboard (ADR-0005, ADR-0011).
# `alchemy deploy` fails if any of these three is unset.
CF_ACCESS_TEAM_DOMAIN=
CF_GOOGLE_IDP_ID=
CF_ACCESS_ALLOW_EMAIL=

# Recorded by the deploy wizard for `scripts/onboard-project.sh`. Not read by
# Alchemy.
#
# CF_ACCESS_CLIENT_SECRET is shown by Cloudflare only once, so the wizard keeps
# it here. This file is gitignored; keep it private.
CLOUDFLARE_ACCOUNT_ID=
DASHBOARD_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
