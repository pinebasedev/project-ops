# Deploy-time configuration for `alchemy deploy` (Phase 6). Not needed for local
# development — the control-plane and dashboard run on vite (see ADR-0009).
#
# `scripts/phase-6-deploy.sh` walks you through obtaining every value and writes
# them here. Copy to `.env` (gitignored) if filling it in by hand.

# Cloudflare account + a token with Workers / D1 / Observability / R2 / Secrets
# Store / Access permissions. The token also becomes the control-plane's own
# Secrets Store entry for querying Workers Observability (ADR-0004).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Zero Trust: the team subdomain (<team>.cloudflareaccess.com) and the UUID of
# the Google identity provider configured in the org. Gate the dashboard's
# interactive login (ADR-0005).
CF_ACCESS_TEAM_DOMAIN=
CF_GOOGLE_IDP_ID=
