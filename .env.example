# Optional configuration, read by Alchemy (`alchemy.run.ts`). Copy to `.env`
# (gitignored) to fill in.
#
# LOCAL DEV (`pnpm dev` = `alchemy dev`) needs none of this — every value has a
# dev fallback. It does need a Cloudflare identity once: `pnpm alchemy login`.
# Set the two CLOUDFLARE_* values here only if you want local Workers
# Observability queries to actually resolve (ADR-0004).
#
# DEPLOY (`scripts/phase-6-deploy.sh`) needs all of it. The wizard walks you
# through obtaining each value and writes them here.

# Cloudflare account + a token with Workers / D1 / Observability / R2 / Secrets
# Store / Access permissions. On deploy the token becomes the control-plane's
# Secrets Store entry for querying Workers Observability.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Deploy only — Zero Trust: the team subdomain (<team>.cloudflareaccess.com) and
# the UUID of the Google identity provider configured in the org. Gate the
# dashboard's interactive login (ADR-0005). `CF_ACCESS_ALLOW_EMAIL` overrides the
# single allow-listed email (defaults to the founder's).
CF_ACCESS_TEAM_DOMAIN=
CF_GOOGLE_IDP_ID=
CF_ACCESS_ALLOW_EMAIL=
