{
  "name": "cloudflare-idp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "check": "pnpm -r --if-present run typecheck && pnpm -r --if-present run check && pnpm run check:alchemy",
    "lint": "oxlint apps alchemy alchemy.run.ts",
    "lint:fix": "oxlint apps alchemy alchemy.run.ts --fix",
    "format": "oxfmt --write apps alchemy alchemy.run.ts",
    "format:check": "oxfmt --check apps alchemy alchemy.run.ts",
    "check:alchemy": "tsc -p tsconfig.alchemy.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.76",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.1.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  }
}
