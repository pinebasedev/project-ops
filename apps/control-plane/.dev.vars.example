# Copy to `.dev.vars` (gitignored) for local development.
#
# Credentials the control plane uses to query the Cloudflare Workers Observability
# Telemetry API for an Environment's recent errors (ADR-0004). The errors route
# (`GET /v1/environments/:id/errors`) returns a "not configured" response until
# both are set.
#
# The API token needs the "Workers Observability Write" account permission (which
# Cloudflare currently requires even to run telemetry queries) for the account
# below. Deployed environments read these from Cloudflare Secrets Store instead
# (Phase 6, P6-04).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Access (ADR-0005, P6-03). The Zero Trust team subdomain
# (`<team>.cloudflareaccess.com`) and the control-plane Access application's
# audience (AUD) tag. When both are set, every `/v1` request except `/v1/health`
# must carry a valid `Cf-Access-Jwt-Assertion`; leave them blank to run the
# Worker ungated for local development. Plain bindings when deployed (not
# secrets) — the stack fills them in from the Access application (ADR-0009).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
