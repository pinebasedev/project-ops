{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      // Placeholder for local dev. The deployed database is provisioned by
      // Alchemy in Phase 6 (P6-01) — the control plane is not deployed before then.
      "database_name": "control-plane",
      "database_id": "local-dev",
      "migrations_dir": "./migrations",
    },
  ],
}
